# Server Configuration
PORT=5000
NODE_ENV=development

# Algorand Testnet Node Configuration (Algonode API Cluster)
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
ALGORAND_NETWORK=testnet

# Algorand Testnet Payment Receiver Address (AVM_ADDRESS)
# The public Algorand address that receives the 0.1 ALGO x402 payments
AVM_ADDRESS=ZMFK2OI7ZBD2U27ISERZC4S6LKM6WMFJPZQ4MYNJDZ2VNBNMBA67RA22AA

# Hosted GoPlausible Facilitator URL for x402 on Algorand
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Optional: External LLM API Keys (Server-Side Only)
# If not provided, the built-in intelligent contextual NLP engine executes autonomously.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
